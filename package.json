    "deploy": "npm run build:worker && wrangler deploy"
  },
  "dependencies": {
    "@astrojs/sitemap": "3.7.3",
    "astro": "6.4.5",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.9",
    "@types/node": "22.19.20",
    "tsx": "^4.23.15",
    "typescript": "5.9.3",
    "vitest": "4.1.8",
    "wrangler": "^4.135.0"
  }
}
