{
  "name": "portfolio-v2",
  "version": "0.0.1",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "typecheck": "astro check",
    "test": "vitest run",
    "build:corpus": "tsx scripts/build-corpus.ts",
    "build:worker": "npm run build && npm run build:corpus",
