---
interface Props {
  title: string;
  /** Right-aligned meta, e.g. a count or a secondary label. */
  meta?: string;
  /** Renders as an h1 on pages where this is the page title. */
  as?: "h1" | "h2";
}

const { title, meta, as: Tag = "h2" }: Props = Astro.props;
---

<div class="section-header">
  <Tag class="section-title">{title}</Tag>
  {meta && <span class="section-meta">{meta}</span>}
</div>

<style>
  .section-header {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    padding-bottom: 0.75rem;
    border-bottom: var(--rule);
  }

  .section-title {
    font-family: var(--font-sans);
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--color-accent);
  }

  .section-meta {
    font-family: var(--font-sans);
    font-size: 0.6875rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-text-muted);
    font-variant-numeric: tabular-nums;
  }
</style>
