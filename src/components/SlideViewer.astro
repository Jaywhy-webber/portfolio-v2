---
import { encodePath } from "../lib/projects";
import type { z } from "zod";
import type { researchViewerSchema } from "../schemas/research";

interface Props {
  viewer: z.infer<typeof researchViewerSchema>;
  /** Used in alt text and the iframe title. */
  title: string;
}

const { viewer, title } = Astro.props;

const slideUrls =
  viewer.kind === "images"
    ? viewer.slides.map((file) => encodePath(`${viewer.basePath}${file}`))
    : [];

/**
 * The Office web viewer needs a publicly reachable absolute URL, so this is
 * built from `site` in astro.config rather than the current origin. In local
 * dev it therefore renders the deployed copy of the deck.
 */
const embedSrc =
  viewer.kind === "embed"
    ? `https://view.officeapps.live.com/op/embed.aspx?src=${encodeURIComponent(
        `${(Astro.site?.origin ?? "").replace(/\/+$/, "")}${viewer.filePath}`,
      )}`
    : "";
---

{viewer.kind === "images" ? (
  <div class="slide-viewer" data-slide-viewer data-slides={JSON.stringify(slideUrls)}>
    <div class="slide-stage">
      <img
        class="slide-stage-img"
        src={slideUrls[0]}
        alt={`${title} — slide 1`}
        data-slide-stage
        width="1280"
        height="720"
      />
    </div>

    <div class="slide-thumbs" data-slide-thumbs>
      {slideUrls.map((url, i) => (
        <button
          type="button"
          class:list={["slide-thumb", { "slide-thumb--active": i === 0 }]}
          data-slide-index={i}
          aria-label={`Go to slide ${i + 1}`}
          aria-current={i === 0 ? "true" : undefined}
        >
          <img src={url} alt="" loading="lazy" width="96" height="54" />
        </button>
      ))}
    </div>

    <div class="slide-controls">
      <button type="button" class="slide-btn" data-slide-prev aria-label="Previous slide">&#8592;</button>
      <span class="slide-counter" data-slide-counter aria-live="polite">1 / {slideUrls.length}</span>
      <button type="button" class="slide-btn" data-slide-next aria-label="Next slide">&#8594;</button>
    </div>
  </div>
) : (
  <div class="slide-viewer">
    <div class="slide-stage">
      <iframe src={embedSrc} title={`${title} slides`} loading="lazy" allowfullscreen></iframe>
    </div>
  </div>
)}

<script>
  function initSlideViewers() {
    document.querySelectorAll<HTMLElement>("[data-slide-viewer]").forEach((viewer) => {
      if (viewer.dataset.slideReady === "true") return;
      viewer.dataset.slideReady = "true";

      let slides: string[] = [];
      try {
        slides = JSON.parse(viewer.dataset.slides ?? "[]");
      } catch {
        return;
      }
      if (slides.length === 0) return;

      const stage = viewer.querySelector<HTMLImageElement>("[data-slide-stage]");
      const counter = viewer.querySelector<HTMLElement>("[data-slide-counter]");
      const thumbs = Array.from(viewer.querySelectorAll<HTMLButtonElement>("[data-slide-index]"));
      if (!stage || !counter) return;

      const baseAlt = stage.alt.replace(/ — slide \d+$/, "");
      let current = 0;

      function go(next: number) {
        const target = (next + slides.length) % slides.length;
        thumbs[current]?.classList.remove("slide-thumb--active");
        thumbs[current]?.removeAttribute("aria-current");

        current = target;
        stage!.src = slides[current];
        stage!.alt = `${baseAlt} — slide ${current + 1}`;
        counter!.textContent = `${current + 1} / ${slides.length}`;

        const thumb = thumbs[current];
        if (thumb) {
          thumb.classList.add("slide-thumb--active");
          thumb.setAttribute("aria-current", "true");
          thumb.scrollIntoView({ block: "nearest", inline: "nearest" });
        }
      }

      viewer.querySelector("[data-slide-prev]")?.addEventListener("click", () => go(current - 1));
      viewer.querySelector("[data-slide-next]")?.addEventListener("click", () => go(current + 1));
      thumbs.forEach((thumb) => {
        thumb.addEventListener("click", () => go(Number(thumb.dataset.slideIndex)));
      });
    });
  }

  document.addEventListener("astro:page-load", initSlideViewers);
</script>

<style>
  .slide-viewer {
    border: var(--rule);
    border-radius: 2px;
    overflow: hidden;
    background: var(--color-surface);
  }

  .slide-stage {
    aspect-ratio: 16 / 9;
    background: var(--color-surface-alt);
  }

  .slide-stage img,
  .slide-stage iframe {
    width: 100%;
    height: 100%;
    border: none;
  }

  .slide-stage img {
    object-fit: contain;
  }

  .slide-thumbs {
    display: flex;
    gap: 4px;
    overflow-x: auto;
    padding: 6px 8px;
    border-top: var(--rule);
    scrollbar-width: thin;
    scrollbar-color: var(--color-border-strong) transparent;
  }

  .slide-thumb {
    flex-shrink: 0;
    padding: 0;
    border: 1px solid transparent;
    background: none;
    cursor: pointer;
    opacity: 0.55;
    line-height: 0;
    transition: opacity 0.15s ease, border-color 0.15s ease;
  }

  .slide-thumb img {
    width: 58px;
    height: 33px;
    object-fit: cover;
  }

  .slide-thumb:hover {
    opacity: 1;
  }

  .slide-thumb--active {
    opacity: 1;
    border-color: var(--color-accent);
  }

  .slide-controls {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 1rem;
    padding: 0.6rem;
    border-top: var(--rule);
  }

  .slide-btn {
    background: none;
    border: 1px solid var(--color-border-strong);
    border-radius: 2px;
    padding: 0.2rem 0.65rem;
    font-size: 0.85rem;
    line-height: 1.3;
    cursor: pointer;
    color: var(--color-text);
    transition: background 0.15s ease, border-color 0.15s ease;
  }

  .slide-btn:hover {
    background: var(--color-surface-alt);
    border-color: var(--color-text);
  }

  .slide-counter {
    font-family: var(--font-sans);
    font-size: 0.6875rem;
    letter-spacing: 0.08em;
    color: var(--color-text-muted);
    min-width: 4.5rem;
    text-align: center;
    font-variant-numeric: tabular-nums;
  }
</style>
