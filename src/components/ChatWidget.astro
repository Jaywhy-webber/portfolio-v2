---
import Icon from "./Icon.astro";
import CopyButton from "./CopyButton.astro";
import { getCollection, type CollectionEntry } from "astro:content";

/**
 * Every route the assistant may cite, with the name to show for it.
 *
 * Two reasons this is a map rather than a list. The model invents
 * descriptive-looking paths ("/about-jerome-yeoh/" for the profile, whose
 * route is "/"), so anything not listed here is dropped rather than linked to
 * a 404. And a raw path makes a poor label: the profile cites "/", which
 * rendered as a bare slash against the sentence's full stop and read as "/.".
 */
const projects = await getCollection("projects");
const routeLabels: Record<string, string> = {
  "/": "Home",
  "/work": "Work",
  "/projects": "Projects",
  "/research": "Research",
  "/workflow": "Workflow",
  "/pipeline": "Pipeline",
  ...Object.fromEntries(
    projects.map((p: CollectionEntry<"projects">) => [`/projects/${p.id}/`, p.data.title]),
  ),
};

/**
 * Grounded assistant. The cat is always reachable; the panel talks to
 * /api/chat on the Worker, which holds the OpenAI key.
 *
 * transition:persist keeps this node alive across view transitions, so a
 * conversation survives clicking through to a project, and so does wherever
 * the visitor dropped the cat.
 */
---

<div class="chat" id="chat-widget" data-routes={JSON.stringify(routeLabels)} transition:persist>
  <!--
    The line the cat stands on. Its box is read in JS for the ground height
    and side gutters, so those live in CSS once instead of being mirrored
    in script, including the mobile values that clear the bottom nav.
  -->
  <div class="chat-floor" data-chat-floor aria-hidden="true"></div>

  <div class="chat-cat" id="chat-cat" data-side="right">
    <!--
      The cat's opening line. A cat on its own doesn't say what it does, so
      this says it once and then gets out of the way for the session.
    -->
    <div class="chat-invite" id="chat-invite" hidden>
      <button type="button" class="chat-invite__cta" data-invite-open>
        Chat with me to know more about Jerome
      </button>
      <button
        type="button"
        class="chat-invite__dismiss"
        data-invite-dismiss
        aria-label="Dismiss this message"
      >
        <Icon name="close" size="0.8rem" />
      </button>
    </div>

    <!-- Purely for show: "Mrrp!" read aloud on every click would be noise. -->
    <p class="chat-say" data-cat-say aria-hidden="true" hidden></p>

    <button
      type="button"
      class="chat-cat__button"
      id="chat-toggle"
      aria-expanded="false"
      aria-controls="chat-panel"
    >
      <span class="chat-cat__sprite" data-cat-sprite data-state="idle"></span>
      <span class="visually-hidden">Ask about Jerome's work</span>
    </button>
  </div>

  <section class="chat-panel" id="chat-panel" aria-label="Ask about Jerome's work" hidden>
    <header class="chat-head">
      <p class="label chat-title">Ask about this site</p>
      <button type="button" class="chat-dismiss" data-chat-close aria-label="Close chat">
        <Icon name="close" size="1rem" />
      </button>
    </header>

    <div class="chat-log" id="chat-log" role="log" aria-live="polite" aria-atomic="false">
      <p class="chat-msg chat-msg--bot chat-intro">
        I can answer from what's written on this site — the projects, the research, the
        workflow. If it isn't covered here, I'll say so rather than guess.
      </p>
    </div>

    <form class="chat-form" id="chat-form">
      <label class="visually-hidden" for="chat-input">Your question</label>
      <input
        id="chat-input"
        class="chat-input"
        type="text"
        autocomplete="off"
        maxlength="600"
        placeholder="What did he build for the kart telemetry?"
      />
      <button type="submit" class="btn btn--filled btn--sm chat-send" data-chat-send>Ask</button>
    </form>

    <footer class="chat-foot">
      <p class="chat-disclaimer">
        Answers come from this site's own content. Confirm anything that matters with Jerome.
      </p>
      <div class="chat-contact">
        <CopyButton value="jeromeyeohhc@gmail.com" label="Copy email" icon="mail" class="btn--sm" />
        <a
          href="https://www.linkedin.com/in/jerome-yeoh-35a738217"
          class="btn btn--icon btn--sm"
          target="_blank"
          rel="noopener noreferrer"
        >
          <Icon name="linkedin" size="1.05rem" />
          <span class="visually-hidden">LinkedIn</span>
        </a>
      </div>
    </footer>
  </section>
</div>

<script>
  import {
    DANCE_MS,
    HEAD,
    IDLE_MS,
    PANEL_HEAD_TOP,
    SQUASH_MS,
    alignToCat,
    clamp,
    dragPosition,
    exceedsDragThreshold,
    fallStep,
    keyboardHeight as measureKeyboard,
    nextState,
    type CatEvent,
    type CatState,
  } from "../lib/cat";

  const STORAGE_KEY = "chat-history";
  const INVITE_KEY = "chat-invite-seen";
  const MAX_TURNS = 8;

  /** The cat's box, matching .chat-cat in the styles below. */
  const CAT_BOX = 100;
  /** Space between the top of the cat's head and the panel, room for the tail. */
  const PANEL_GAP = 14;
  /** Half the tail's width, and how close it may come to a panel corner. */
  const TAIL_HALF = 8;
  const TAIL_INSET = 12;
  /** Room kept clear above the panel at the top of the window. */
  const PANEL_TOP = 16;
  /** Pointer releases this soon after a drag are the drag's own click. */
  const DROP_CLICK_MS = 400;
  const SWING_MS = 100;

  const SPRITES = ["idle", "nap", "drag", "click"].map((s) => `/assets/cat/cat-${s}.png`);

  /** Pixel heart, 7 by 6, drawn at 3x. */
  const HEART_SVG =
    '<svg viewBox="0 0 7 6" width="21" height="18" shape-rendering="crispEdges">' +
    '<path fill="currentColor" d="M1 0h2v1H1zM4 0h2v1H4zM0 1h7v2H0zM1 3h5v1H1zM2 4h3v1H2zM3 5h1v1H3z"/>' +
    "</svg>";

  interface Turn {
    role: "user" | "assistant";
    content: string;
  }

  function loadHistory(): Turn[] {
    try {
      const raw = sessionStorage.getItem(STORAGE_KEY);
      return raw ? (JSON.parse(raw) as Turn[]) : [];
    } catch {
      // Private mode, blocked storage — the widget still works, just forgetful.
      return [];
    }
  }

  function saveHistory(turns: Turn[]) {
    try {
      sessionStorage.setItem(STORAGE_KEY, JSON.stringify(turns.slice(-MAX_TURNS)));
    } catch {
      /* not worth surfacing */
    }
  }

  function initChat() {
    const widget = document.getElementById("chat-widget");
    if (!widget || widget.dataset.chatReady === "true") return;
    widget.dataset.chatReady = "true";

    const toggle = document.getElementById("chat-toggle") as HTMLButtonElement | null;
    const panel = document.getElementById("chat-panel") as HTMLElement | null;
    const log = document.getElementById("chat-log") as HTMLElement | null;
    const form = document.getElementById("chat-form") as HTMLFormElement | null;
    const input = document.getElementById("chat-input") as HTMLInputElement | null;
    const send = widget.querySelector<HTMLButtonElement>("[data-chat-send]");
    const cat = document.getElementById("chat-cat");
    const sprite = widget.querySelector<HTMLElement>("[data-cat-sprite]");
    const say = widget.querySelector<HTMLElement>("[data-cat-say]");
    const floorProbe = widget.querySelector<HTMLElement>("[data-chat-floor]");
    if (!toggle || !panel || !log || !form || !input || !send) return;
    if (!cat || !sprite || !say || !floorProbe) return;

    let history = loadHistory();
    let busy = false;

    function bubble(role: "user" | "bot", text = ""): HTMLElement {
      const el = document.createElement("p");
      el.className = `chat-msg chat-msg--${role}`;
      el.textContent = text;
      log!.appendChild(el);
      log!.scrollTop = log!.scrollHeight;
      return el;
    }

    /**
     * Animated dots for the wait before the first token. Setting textContent
     * on the bubble later replaces these, so nothing has to clean them up.
     */
    function showTyping(el: HTMLElement) {
      const dots = document.createElement("span");
      dots.className = "chat-typing";
      // Decorative: the log is aria-live, and announcing dots would be noise.
      dots.setAttribute("aria-hidden", "true");
      for (let i = 0; i < 3; i++) dots.appendChild(document.createElement("i"));
      el.appendChild(dots);
    }

    let routeLabels: Record<string, string> = {};
    try {
      routeLabels = JSON.parse(widget.dataset.routes ?? "{}");
    } catch {
      /* no map means no citation is trusted, which fails safe */
    }

    /**
     * Turns [/route] citations into links once a reply has finished.
     *
     * Only routes that actually exist become links. The model sometimes cites
     * a document id, or invents a descriptive path like "/about-jerome-yeoh/"
     * for the profile document (whose route is "/"). Either would render as a
     * link to a 404, so anything unrecognised is dropped from the text
     * entirely rather than shown as a broken reference.
     */
    function linkCitations(el: HTMLElement) {
      const text = el.textContent ?? "";
      if (!text.includes("[/")) return;
      el.replaceChildren();
      let cursor = 0;
      for (const match of text.matchAll(/\s*\[(\/[^\]]*)\]/g)) {
        const at = match.index ?? 0;
        el.append(text.slice(cursor, at));

        // The model sometimes lists several routes in one bracket, as
        // "[/work, /research#databusters]" or space-separated, despite being
        // told not to. Each is linked on its own.
        const routes = match[1]
          .split(/[,\s]+/)
          // It also pulls the sentence's punctuation inside the brackets,
          // e.g. "[/.]" for the home route. Trim it before matching, otherwise
          // a perfectly good citation gets thrown away.
          .map((part) => part.replace(/[.,;:]+$/, ""))
          .filter((route) => routeLabels[route]);

        const links = [...new Set(routes)].map((route) => {
          const a = document.createElement("a");
          a.href = route;
          a.className = "chat-cite";
          a.textContent = routeLabels[route];
          return a;
        });
        if (links.length) {
          el.append(" (");
          links.forEach((a, i) => el.append(...(i ? [", ", a] : [a])));
          el.append(")");
        }
        cursor = at + match[0].length;
      }
      el.append(text.slice(cursor));
    }

    for (const turn of history) {
      bubble(turn.role === "user" ? "user" : "bot", turn.content);
    }

    const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)");

    // The cat's left edge, or null while it sits at home, so that home keeps
    // tracking the right of the window as it resizes. catY is its top edge.
    let catX: number | null = null;
    let catY = 0;
    let airborne = false;

    function floor() {
      const r = floorProbe!.getBoundingClientRect();
      return { left: r.left, right: r.right, ground: r.top };
    }

    function keyboardHeight(): number {
      const vv = window.visualViewport;
      if (!vv) return 0;
      return measureKeyboard(window.innerHeight, vv.height, vv.offsetTop, vv.scale);
    }

    /**
     * Puts the cat where its state says, back on the ground unless it is in
     * the air, and keeps the open panel above it. The panel stays put while
     * the cat is carried around and catches up when it lands.
     */
    function placeCat() {
      const f = floor();
      const homeX = f.right - CAT_BOX;
      const x = catX === null ? homeX : clamp(catX, f.left, homeX);
      if (catX !== null) catX = x;
      if (!airborne) catY = f.ground - CAT_BOX;

      const head = HEAD[catState];
      cat!.style.setProperty("--cat-x", `${x}px`);
      cat!.style.setProperty("--cat-y", `${catY}px`);
      cat!.style.setProperty("--cat-head", `${head.x}px`);
      cat!.style.setProperty("--cat-head-top", `${head.top}px`);
      cat!.dataset.placed = "true";
      cat!.dataset.side = alignToCat(x, CAT_BOX, 0, f).side;

      if (panel!.hidden || airborne) return;
      // Custom properties rather than inline left/bottom, so the full-screen
      // mobile panel in the stylesheet can ignore them.
      const width = panel!.offsetWidth;
      const { left } = alignToCat(x, CAT_BOX, width, f);
      // The tail points at the cat's head, even when the panel was pushed
      // sideways to stay on screen, but never past the panel's corners.
      const tail = clamp(x + head.x - TAIL_HALF - left, TAIL_INSET, width - TAIL_INSET - 2 * TAIL_HALF);
      const headY = catY + PANEL_HEAD_TOP;
      widget!.style.setProperty("--panel-left", `${left}px`);
      widget!.style.setProperty("--panel-tail", `${tail}px`);
      widget!.dataset.placed = "true";

      // An on-screen keyboard shrinks only the visual viewport, so a panel
      // anchored over the cat would sit behind it, input and all. While it is
      // up, the panel stands on the keyboard and fills what is still visible.
      const keyboard = keyboardHeight();
      widget!.classList.toggle("chat--keyboard", keyboard > 0);
      if (keyboard > 0) {
        const visible = window.visualViewport!.height;
        widget!.style.setProperty("--panel-bottom", `${keyboard + PANEL_TOP}px`);
        widget!.style.setProperty("--panel-max-h", `${Math.max(0, visible - 2 * PANEL_TOP)}px`);
        return;
      }
      widget!.style.setProperty("--panel-bottom", `${window.innerHeight - headY + PANEL_GAP}px`);
      widget!.style.setProperty("--panel-max-h", `${Math.max(0, headY - PANEL_GAP - PANEL_TOP)}px`);
    }

    function setOpen(open: boolean) {
      panel!.hidden = !open;
      toggle!.setAttribute("aria-expanded", String(open));
      widget!.classList.toggle("chat--open", open);
      placeCat();
      if (open) input!.focus();
      else toggle!.focus();
    }

    const invite = document.getElementById("chat-invite");
    // Done once the visitor opens the chat or waves the invite away. Until
    // then it stays up, stepping aside only while the cat says something else.
    let inviteDone = false;
    let inviteDue = false;

    function showInvite() {
      if (invite && inviteDue && !inviteDone && panel!.hidden && say!.hidden) {
        invite.hidden = false;
      }
    }

    function dismissInvite() {
      if (inviteDone) return;
      inviteDone = true;
      if (invite) invite.hidden = true;
      try {
        sessionStorage.setItem(INVITE_KEY, "1");
      } catch {
        /* blocked storage just means it may reappear next page */
      }
    }

    // Held back briefly so it doesn't compete with the page painting, and
    // never shown to someone who has already opened the chat or waved it away.
    if (invite && history.length === 0) {
      let seen = false;
      try {
        seen = sessionStorage.getItem(INVITE_KEY) === "1";
      } catch {
        /* treat unreadable storage as unseen */
      }
      if (!seen) {
        window.setTimeout(() => {
          inviteDue = true;
          showInvite();
        }, 1200);
      }
    }

    let catState: CatState = "idle";
    let idleTimer = 0;
    let stateTimer = 0;
    let sayTimer = 0;

    function enter(event: CatEvent): CatState {
      catState = nextState(catState, event);
      sprite!.dataset.state = catState;
      // Each pose holds its head somewhere else; re-aim the bubble tails.
      placeCat();
      window.clearTimeout(idleTimer);
      if (catState === "idle") scheduleIdle();
      return catState;
    }

    /** A short line over the cat's head. Zero ms keeps it up until replaced. */
    function speak(text: string, ms: number) {
      window.clearTimeout(sayTimer);
      if (invite) invite.hidden = true;
      say!.textContent = text;
      say!.hidden = false;
      if (ms > 0) sayTimer = window.setTimeout(hush, ms);
    }

    function hush() {
      window.clearTimeout(sayTimer);
      say!.hidden = true;
      showInvite();
    }

    function scheduleIdle() {
      window.clearTimeout(idleTimer);
      idleTimer = window.setTimeout(() => {
        // Never while someone is reading the chat. Once asleep it stays
        // asleep until tapped or picked up.
        enter({ type: "idleTimeout", nap: panel!.hidden });
      }, IDLE_MS);
    }

    function floatHeart() {
      if (reducedMotion.matches) return;
      const heart = document.createElement("span");
      heart.className = "chat-cat__heart";
      heart.setAttribute("aria-hidden", "true");
      heart.innerHTML = HEART_SVG;
      heart.addEventListener("animationend", () => heart.remove());
      cat!.appendChild(heart);
    }

    /** Click, tap or Enter: the cat dances and the panel opens or closes. */
    function tapCat() {
      dismissInvite();
      window.clearTimeout(stateTimer);
      const opening = panel!.hidden;
      enter({ type: "tap" });
      // Opening needs no line: the panel itself is what the cat says.
      if (opening) hush();
      else speak("Mrrp!", DANCE_MS);
      floatHeart();
      stateTimer = window.setTimeout(() => {
        if (catState === "click") enter({ type: "danceEnd" });
      }, DANCE_MS);
      setOpen(opening);
    }

    let press: { id: number; x: number; y: number } | null = null;
    let droppedAt = -Infinity;
    let swingTimer = 0;
    let fallFrame = 0;

    function startDrag() {
      window.clearTimeout(stateTimer);
      window.cancelAnimationFrame(fallFrame);
      if (catX === null) catX = floor().right - CAT_BOX;
      airborne = true;
      enter({ type: "drag" });
      cat!.classList.add("chat-cat--held");
      speak("Eek! Put me down!", 0);
      if (reducedMotion.matches) return;
      let tilt = 6;
      window.clearInterval(swingTimer);
      swingTimer = window.setInterval(() => {
        cat!.style.setProperty("--cat-tilt", `${tilt}deg`);
        tilt = -tilt;
      }, SWING_MS);
    }

    function land() {
      airborne = false;
      enter({ type: "land" });
      placeCat();
      if (reducedMotion.matches) return;
      cat!.classList.add("chat-cat--landed");
      window.setTimeout(() => cat!.classList.remove("chat-cat--landed"), SQUASH_MS);
    }

    function drop() {
      window.clearInterval(swingTimer);
      cat!.style.removeProperty("--cat-tilt");
      cat!.classList.remove("chat-cat--held");
      hush();
      enter({ type: "drop" });
      if (reducedMotion.matches) return land();

      let velocity = 0;
      let last = performance.now();
      const step = (now: number) => {
        // Capped so a backgrounded tab doesn't come back to one huge step.
        const dt = Math.min((now - last) / 1000, 0.05);
        last = now;
        const next = fallStep(catY, velocity, dt, floor().ground - CAT_BOX);
        catY = next.y;
        velocity = next.velocity;
        placeCat();
        if (next.landed) land();
        else fallFrame = window.requestAnimationFrame(step);
      };
      fallFrame = window.requestAnimationFrame(step);
    }

    toggle.addEventListener("pointerdown", (e) => {
      if (e.button !== 0) return;
      press = { id: e.pointerId, x: e.clientX, y: e.clientY };
      toggle.setPointerCapture(e.pointerId);
      // Caught on the way down: it hangs where it was grabbed.
      if (catState === "fall") startDrag();
    });

    toggle.addEventListener("pointermove", (e) => {
      if (!press || e.pointerId !== press.id) return;
      if (catState !== "drag") {
        if (!exceedsDragThreshold(e.clientX - press.x, e.clientY - press.y)) return;
        startDrag();
      }
      const f = floor();
      const at = dragPosition(e.clientX, e.clientY, CAT_BOX, CAT_BOX, f, f.ground);
      catX = at.x;
      catY = at.y;
      placeCat();
    });

    function endPress(e: PointerEvent) {
      if (!press || e.pointerId !== press.id) return;
      press = null;
      if (catState !== "drag") return;
      droppedAt = performance.now();
      drop();
    }
    toggle.addEventListener("pointerup", endPress);
    toggle.addEventListener("pointercancel", endPress);

    // Keyboard activation arrives here too, as a click with no pointer.
    toggle.addEventListener("click", () => {
      // The click a browser fires after a drag ends is not a tap.
      if (performance.now() - droppedAt < DROP_CLICK_MS) return;
      tapCat();
    });

    window.addEventListener("resize", placeCat);
    // The keyboard opening and closing moves only the visual viewport.
    window.visualViewport?.addEventListener("resize", placeCat);
    window.visualViewport?.addEventListener("scroll", placeCat);
    placeCat();
    scheduleIdle();
    // Warm the other states so the first nap or drag doesn't flash empty.
    for (const src of SPRITES) new Image().src = src;

    invite?.querySelector("[data-invite-dismiss]")?.addEventListener("click", dismissInvite);
    invite?.querySelector("[data-invite-open]")?.addEventListener("click", tapCat);
    widget.querySelectorAll("[data-chat-close]").forEach((el) =>
      el.addEventListener("click", () => setOpen(false)),
    );
    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape" && !panel.hidden) setOpen(false);
    });

    form.addEventListener("submit", async (event) => {
      event.preventDefault();
      const question = input.value.trim();
      if (!question || busy) return;

      busy = true;
      send.disabled = true;
      input.value = "";
      bubble("user", question);
      history.push({ role: "user", content: question });

      const reply = bubble("bot");
      reply.classList.add("chat-msg--pending");
      showTyping(reply);
      let answer = "";

      try {
        const response = await fetch("/api/chat", {
          method: "POST",
          headers: { "content-type": "application/json" },
          body: JSON.stringify({ question, history: history.slice(0, -1) }),
        });
        if (!response.ok || !response.body) throw new Error(String(response.status));

        const readerStream = response.body.getReader();
        const decoder = new TextDecoder();
        let buffer = "";

        for (;;) {
          const { done, value } = await readerStream.read();
          if (done) break;
          buffer += decoder.decode(value, { stream: true });
          const lines = buffer.split("\n");
          buffer = lines.pop() ?? "";

          for (const line of lines) {
            if (!line.startsWith("data: ")) continue;
            const payload = line.slice(6).trim();
            if (!payload || payload === "[DONE]") continue;
            try {
              const { text } = JSON.parse(payload) as { text?: string };
              if (text) {
                answer += text;
                reply.textContent = answer;
                reply.classList.remove("chat-msg--pending");
                log.scrollTop = log.scrollHeight;
              }
            } catch {
              /* skip a malformed chunk rather than dropping the stream */
            }
          }
        }
      } catch {
        answer = "I couldn't reach the assistant just now. Jerome's contact details are below.";
        reply.textContent = answer;
      }

      reply.classList.remove("chat-msg--pending");
      linkCitations(reply);
      history.push({ role: "assistant", content: answer });
      history = history.slice(-MAX_TURNS);
      saveHistory(history);

      busy = false;
      send.disabled = false;
      input.focus();
    });
  }

  document.addEventListener("astro:page-load", initChat);
</script>

<style>
  /* Not positioned itself: the cat and the panel are each fixed in place. */
  .chat {
    --chat-gutter: 1.25rem;
    --chat-ground: 1.25rem;
  }

  .chat-floor {
    position: fixed;
    left: var(--chat-gutter);
    right: var(--chat-gutter);
    bottom: var(--chat-ground);
    height: 0;
    visibility: hidden;
    pointer-events: none;
  }

  .chat-cat {
    /* Home, until the script takes over placement. */
    position: fixed;
    right: var(--chat-gutter);
    bottom: var(--chat-ground);
    /* Above the mobile nav (70) and the panel, below the demo overlay (100)
       so launching a demo covers the chat rather than fighting it. */
    z-index: 81;
    width: 100px;
    height: 100px;
  }

  .chat-cat[data-placed] {
    top: 0;
    left: 0;
    right: auto;
    bottom: auto;
    transform: translate(var(--cat-x), var(--cat-y));
  }

  .chat-cat__button {
    position: relative;
    display: block;
    width: 100%;
    height: 100%;
    padding: 0;
    border: none;
    background: none;
    cursor: pointer;
    /* Without this a touch drag scrolls the page instead of lifting the cat. */
    touch-action: none;
    user-select: none;
    -webkit-user-select: none;
    -webkit-tap-highlight-color: transparent;
    /* Held by the scruff, so it swings from the top. */
    transform-origin: 50% 0;
    transform: rotate(var(--cat-tilt, 0deg));
  }

  .chat-cat--held .chat-cat__button {
    cursor: grabbing;
  }

  .chat-cat--landed .chat-cat__button {
    transform-origin: 50% 100%;
    transform: scale(1.12, 0.84);
  }

  /*
   * The strips hold every frame left to right; steps() walks the background
