---
import Icon from "./Icon.astro";
import CopyButton from "./CopyButton.astro";

/**
 * Grounded assistant. The bubble is always reachable; the panel talks to
 * /api/chat on the Worker, which holds the OpenAI key.
 *
 * transition:persist keeps this node alive across view transitions, so a
 * conversation survives clicking through to a project.
 */
---

<div class="chat" id="chat-widget" transition:persist>
  <div class="chat-launcher">
    <!--
      Invitation beside the bubble. An icon on its own doesn't say what it
      does, so this says it once and then gets out of the way for the session.
    -->
    <div class="chat-invite" id="chat-invite" hidden>
      <button type="button" class="chat-invite__cta" data-invite-open>
        Chat with me to know more about Jerome
      </button>
      <button
        type="button"
        class="chat-invite__dismiss"
        data-invite-dismiss
        aria-label="Dismiss this message"
      >
        <Icon name="close" size="0.8rem" />
      </button>
    </div>

    <button
      type="button"
      class="chat-bubble"
      id="chat-toggle"
      aria-expanded="false"
      aria-controls="chat-panel"
    >
      <span class="chat-bubble__open" data-chat-glyph="closed">
        <Icon name="chat" size="1.35rem" />
      </span>
      <span class="chat-bubble__close" data-chat-glyph="open" hidden>
        <Icon name="close" size="1.35rem" />
      </span>
      <span class="visually-hidden">Ask about Jerome's work</span>
    </button>
  </div>

  <section class="chat-panel" id="chat-panel" aria-label="Ask about Jerome's work" hidden>
    <header class="chat-head">
      <p class="label chat-title">Ask about this site</p>
      <button type="button" class="chat-dismiss" data-chat-close aria-label="Close chat">
        <Icon name="close" size="1rem" />
      </button>
    </header>

    <div class="chat-log" id="chat-log" role="log" aria-live="polite" aria-atomic="false">
      <p class="chat-msg chat-msg--bot chat-intro">
        I can answer from what's written on this site — the projects, the research, the
        workflow. If it isn't covered here, I'll say so rather than guess.
      </p>
    </div>

    <form class="chat-form" id="chat-form">
      <label class="visually-hidden" for="chat-input">Your question</label>
      <input
        id="chat-input"
        class="chat-input"
        type="text"
        autocomplete="off"
        maxlength="600"
        placeholder="What did he build for the kart telemetry?"
      />
      <button type="submit" class="btn btn--filled btn--sm chat-send" data-chat-send>Ask</button>
    </form>

    <footer class="chat-foot">
      <p class="chat-disclaimer">
        Answers come from this site's own content. Confirm anything that matters with Jerome.
      </p>
      <div class="chat-contact">
        <CopyButton value="jeromeyeohhc@gmail.com" label="Copy email" icon="mail" class="btn--sm" />
        <a
          href="https://www.linkedin.com/in/jerome-yeoh-35a738217"
          class="btn btn--icon btn--sm"
          target="_blank"
          rel="noopener noreferrer"
        >
          <Icon name="linkedin" size="1.05rem" />
          <span class="visually-hidden">LinkedIn</span>
        </a>
      </div>
    </footer>
  </section>
</div>

<script>
  const STORAGE_KEY = "chat-history";
  const INVITE_KEY = "chat-invite-seen";
  const MAX_TURNS = 8;

  interface Turn {
    role: "user" | "assistant";
    content: string;
  }

  function loadHistory(): Turn[] {
    try {
      const raw = sessionStorage.getItem(STORAGE_KEY);
      return raw ? (JSON.parse(raw) as Turn[]) : [];
    } catch {
      // Private mode, blocked storage — the widget still works, just forgetful.
      return [];
    }
  }

  function saveHistory(turns: Turn[]) {
    try {
      sessionStorage.setItem(STORAGE_KEY, JSON.stringify(turns.slice(-MAX_TURNS)));
    } catch {
      /* not worth surfacing */
    }
  }

  function initChat() {
    const widget = document.getElementById("chat-widget");
    if (!widget || widget.dataset.chatReady === "true") return;
    widget.dataset.chatReady = "true";

    const toggle = document.getElementById("chat-toggle") as HTMLButtonElement | null;
    const panel = document.getElementById("chat-panel") as HTMLElement | null;
    const log = document.getElementById("chat-log") as HTMLElement | null;
    const form = document.getElementById("chat-form") as HTMLFormElement | null;
    const input = document.getElementById("chat-input") as HTMLInputElement | null;
    const send = widget.querySelector<HTMLButtonElement>("[data-chat-send]");
    if (!toggle || !panel || !log || !form || !input || !send) return;

    let history = loadHistory();
    let busy = false;

    function bubble(role: "user" | "bot", text = ""): HTMLElement {
      const el = document.createElement("p");
      el.className = `chat-msg chat-msg--${role}`;
      el.textContent = text;
      log!.appendChild(el);
      log!.scrollTop = log!.scrollHeight;
      return el;
    }

    /**
     * Animated dots for the wait before the first token. Setting textContent
     * on the bubble later replaces these, so nothing has to clean them up.
     */
    function showTyping(el: HTMLElement) {
      const dots = document.createElement("span");
      dots.className = "chat-typing";
      // Decorative: the log is aria-live, and announcing dots would be noise.
      dots.setAttribute("aria-hidden", "true");
      for (let i = 0; i < 3; i++) dots.appendChild(document.createElement("i"));
      el.appendChild(dots);
    }

    /** Turns [/route] citations into real links once a reply has finished. */
    function linkCitations(el: HTMLElement) {
      const text = el.textContent ?? "";
      if (!text.includes("[/")) return;
      el.replaceChildren();
      let cursor = 0;
      // Routes only — a colon means the model cited a document id, which
      // would otherwise render as a link to a page that does not exist.
      for (const match of text.matchAll(/\[(\/[^\]\s:]*)\]/g)) {
        const at = match.index ?? 0;
        el.append(text.slice(cursor, at));
        const a = document.createElement("a");
        a.href = match[1];
        a.className = "chat-cite";
        a.textContent = match[1];
        el.append(a);
        cursor = at + match[0].length;
      }
      el.append(text.slice(cursor));
    }

    for (const turn of history) {
      bubble(turn.role === "user" ? "user" : "bot", turn.content);
    }

    function setOpen(open: boolean) {
      panel!.hidden = !open;
      toggle!.setAttribute("aria-expanded", String(open));
      widget!.classList.toggle("chat--open", open);
      widget!.querySelectorAll<HTMLElement>("[data-chat-glyph]").forEach((g) => {
        g.hidden = g.dataset.chatGlyph !== (open ? "open" : "closed");
      });
      if (open) input!.focus();
      else toggle!.focus();
    }

    const invite = document.getElementById("chat-invite");

    function dismissInvite() {
      if (!invite || invite.hidden) return;
      invite.hidden = true;
      try {
        sessionStorage.setItem(INVITE_KEY, "1");
      } catch {
        /* blocked storage just means it may reappear next page */
      }
    }

    // Held back briefly so it doesn't compete with the page painting, and
    // never shown to someone who has already opened the chat or waved it away.
    if (invite && history.length === 0) {
      let seen = false;
      try {
        seen = sessionStorage.getItem(INVITE_KEY) === "1";
      } catch {
        /* treat unreadable storage as unseen */
      }
      if (!seen) window.setTimeout(() => { if (panel.hidden) invite.hidden = false; }, 1200);
    }

    invite?.querySelector("[data-invite-dismiss]")?.addEventListener("click", dismissInvite);
    invite?.querySelector("[data-invite-open]")?.addEventListener("click", () => {
      dismissInvite();
      setOpen(true);
    });

    toggle.addEventListener("click", () => {
      dismissInvite();
      setOpen(panel.hidden);
    });
    widget.querySelectorAll("[data-chat-close]").forEach((el) =>
      el.addEventListener("click", () => setOpen(false)),
    );
    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape" && !panel.hidden) setOpen(false);
    });

    form.addEventListener("submit", async (event) => {
      event.preventDefault();
      const question = input.value.trim();
      if (!question || busy) return;

      busy = true;
      send.disabled = true;
      input.value = "";
      bubble("user", question);
      history.push({ role: "user", content: question });

      const reply = bubble("bot");
      reply.classList.add("chat-msg--pending");
      showTyping(reply);
      let answer = "";

      try {
        const response = await fetch("/api/chat", {
          method: "POST",
          headers: { "content-type": "application/json" },
          body: JSON.stringify({ question, history: history.slice(0, -1) }),
        });
        if (!response.ok || !response.body) throw new Error(String(response.status));

        const readerStream = response.body.getReader();
        const decoder = new TextDecoder();
        let buffer = "";

        for (;;) {
          const { done, value } = await readerStream.read();
          if (done) break;
          buffer += decoder.decode(value, { stream: true });
          const lines = buffer.split("\n");
          buffer = lines.pop() ?? "";

          for (const line of lines) {
            if (!line.startsWith("data: ")) continue;
            const payload = line.slice(6).trim();
            if (!payload || payload === "[DONE]") continue;
            try {
              const { text } = JSON.parse(payload) as { text?: string };
              if (text) {
                answer += text;
                reply.textContent = answer;
                reply.classList.remove("chat-msg--pending");
                log.scrollTop = log.scrollHeight;
              }
            } catch {
              /* skip a malformed chunk rather than dropping the stream */
            }
          }
        }
      } catch {
        answer = "I couldn't reach the assistant just now. Jerome's contact details are below.";
        reply.textContent = answer;
      }

      reply.classList.remove("chat-msg--pending");
      linkCitations(reply);
      history.push({ role: "assistant", content: answer });
      history = history.slice(-MAX_TURNS);
      saveHistory(history);

      busy = false;
      send.disabled = false;
      input.focus();
    });
  }

  document.addEventListener("astro:page-load", initChat);
</script>

<style>
  .chat {
    position: fixed;
    right: 1.25rem;
    bottom: 1.25rem;
    /* Above the mobile nav (70), below the demo overlay (100) so launching a
       demo covers the chat rather than fighting it. */
    z-index: 80;
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 0.75rem;
  }

  /* Invite and bubble sit on one row so the callout reads as coming from it. */
  .chat-launcher {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: 0.6rem;
  }

  .chat-invite {
    position: relative;
    display: flex;
    align-items: center;
    gap: 0.15rem;
    max-width: min(15rem, calc(100vw - 6.5rem));
    padding: 0.55rem 0.35rem 0.55rem 0.8rem;
    border: 1px solid var(--color-border-strong);
    border-radius: 2px;
    background: var(--color-surface);
    box-shadow: 0 6px 20px color-mix(in srgb, var(--color-text) 14%, transparent);
    animation: chat-invite-in 0.28s ease-out both;
  }

  /* Tail pointing at the bubble, drawn as two triangles so the border shows. */
  .chat-invite::before,
  .chat-invite::after {
    content: "";
    position: absolute;
    top: 50%;
    left: 100%;
    transform: translateY(-50%);
    border: 6px solid transparent;
  }

  .chat-invite::before {
    border-left-color: var(--color-border-strong);
  }

  .chat-invite::after {
    margin-left: -1px;
    border-left-color: var(--color-surface);
  }

  .chat-invite__cta {
    flex: 1;
    min-width: 0;
    background: none;
    border: none;
    padding: 0;
    text-align: left;
    font-size: 0.75rem;
    line-height: 1.4;
    color: var(--color-text);
    cursor: pointer;
  }

  .chat-invite__cta:hover {
    color: var(--color-accent);
  }

  .chat-invite__dismiss {
    flex-shrink: 0;
    align-self: flex-start;
    background: none;
    border: none;
    padding: 0.1rem;
    line-height: 0;
    color: var(--color-text-muted);
    cursor: pointer;
  }

  .chat-invite__dismiss:hover {
    color: var(--color-text);
  }

  @keyframes chat-invite-in {
    from {
      opacity: 0;
      transform: translateX(0.5rem);
    }
    to {
      opacity: 1;
      transform: translateX(0);
    }
  }

  /* The global reduced-motion rule collapses the entrance to nothing, which
     would leave it mid-slide. Land it in its final position instead. */
  @media (prefers-reduced-motion: reduce) {
    .chat-invite {
      animation: none;
      opacity: 1;
      transform: none;
    }
  }

  .chat-bubble {
    width: 3rem;
    height: 3rem;
    border-radius: 50%;
    border: 1px solid var(--color-accent);
    background: var(--color-accent);
    color: var(--color-on-accent);
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    box-shadow: 0 6px 20px color-mix(in srgb, var(--color-text) 22%, transparent);
    transition: background 0.15s ease, transform 0.15s ease;
  }

  .chat-bubble:hover {
    background: var(--color-accent-hover);
    transform: translateY(-2px);
  }

  .chat-panel {
    width: min(23rem, calc(100vw - 2.5rem));
    max-height: min(32rem, calc(100vh - 8rem));
    display: flex;
    flex-direction: column;
    order: -1;
    background: var(--color-surface);
    border: 1px solid var(--color-border-strong);
    border-radius: 2px;
    box-shadow: 0 18px 44px color-mix(in srgb, var(--color-text) 20%, transparent);
    overflow: hidden;
  }

  .chat-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.7rem 0.9rem;
    border-bottom: var(--rule);
  }

  .chat-dismiss {
    background: none;
    border: none;
    padding: 0.15rem;
    cursor: pointer;
    color: var(--color-text-muted);
  }

  .chat-dismiss:hover {
    color: var(--color-text);
  }

  .chat-log {
    flex: 1;
    overflow-y: auto;
    padding: 0.9rem;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }

  /*
   * Message bubbles are created in JS, so they never receive Astro's
   * data-astro-cid attribute and scoped selectors would not match them.
   * These rules have to be global to reach a dynamically appended node.
   */
  :global(.chat-msg) {
    font-size: 0.8125rem;
    line-height: 1.55;
    padding: 0.5rem 0.7rem;
    border-radius: 2px;
    max-width: 90%;
    /* Model replies can contain real newlines worth keeping. */
    white-space: pre-wrap;
  }

  :global(.chat-msg--user) {
    align-self: flex-end;
    background: var(--color-accent-soft);
    color: var(--color-text);
  }

  :global(.chat-msg--bot) {
    align-self: flex-start;
    background: var(--color-surface-alt);
    color: var(--color-text);
  }

  /* Authored in the template, so its source indentation would survive
     pre-wrap as stray leading spaces. */
  .chat-intro {
    color: var(--color-text-muted);
    white-space: normal;
  }

  /* Three dots riding a wave while the first token is in flight. */
  :global(.chat-typing) {
    display: inline-flex;
    align-items: center;
    gap: 0.28rem;
    padding-block: 0.2rem;
  }

  :global(.chat-typing i) {
    width: 0.3rem;
    height: 0.3rem;
    border-radius: 50%;
    background: var(--color-text-muted);
    animation: chat-typing-bounce 1.1s ease-in-out infinite;
  }

  :global(.chat-typing i:nth-child(2)) {
    animation-delay: 0.16s;
  }

  :global(.chat-typing i:nth-child(3)) {
    animation-delay: 0.32s;
  }

  @keyframes chat-typing-bounce {
    0%,
    70%,
    100% {
      transform: translateY(0);
      opacity: 0.45;
    }
    35% {
      transform: translateY(-0.28rem);
      opacity: 1;
    }
  }

  /*
   * The global reduced-motion rule collapses animations to 0.01ms, which would
   * freeze the dots at whatever keyframe they land on. Hold them steady and
   * legible instead, so the bubble still reads as "waiting".
   */
  @media (prefers-reduced-motion: reduce) {
    :global(.chat-typing i) {
      animation: none;
      opacity: 0.6;
      transform: none;
    }
  }

  :global(.chat-cite) {
    font-size: 0.75rem;
    color: var(--color-accent);
    border-bottom: 1px solid color-mix(in srgb, var(--color-accent) 35%, transparent);
  }

  .chat-form {
    display: flex;
    gap: 0.5rem;
    padding: 0.7rem 0.9rem;
    border-top: var(--rule);
  }

  .chat-input {
    flex: 1;
    min-width: 0;
    font: inherit;
    font-size: 0.8125rem;
    padding: 0.4rem 0.55rem;
    border: 1px solid var(--color-border-strong);
    border-radius: 2px;
    background: var(--color-bg);
    color: var(--color-text);
  }

  .chat-send:disabled {
    opacity: 0.55;
    cursor: default;
  }

  .chat-foot {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    padding: 0.6rem 0.9rem;
    border-top: var(--rule);
    background: var(--color-bg);
  }

  .chat-disclaimer {
    font-size: 0.625rem;
    line-height: 1.45;
    color: var(--color-text-muted);
  }

  .chat-contact {
    display: flex;
    gap: 0.4rem;
    flex-shrink: 0;
  }

  @media (max-width: 860px) {
    .chat {
      /* Clear the fixed bottom nav rather than covering its last slot. */
      bottom: calc(var(--mobile-nav-height) + 1rem);
      right: 1rem;
      left: 1rem;
      align-items: flex-end;
    }

    /* A floating card is unusable at 390px, so the panel takes the screen. */
    .chat--open .chat-panel {
      position: fixed;
      inset: 0 0 var(--mobile-nav-height) 0;
      width: auto;
      max-height: none;
      border: none;
      border-radius: 0;
    }

    .chat--open .chat-bubble {
      position: relative;
      z-index: 1;
    }
  }
</style>
