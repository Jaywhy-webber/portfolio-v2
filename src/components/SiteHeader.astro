---
export interface NavItem {
  label: string;
  href: string;
}

export const NAV_ITEMS: NavItem[] = [
  { label: "Work", href: "/work" },
  { label: "Projects", href: "/projects" },
  { label: "Research", href: "/research" },
  { label: "Workflow", href: "/workflow" },
  { label: "Pipeline", href: "/pipeline" },
];

interface Props {
  /** Route that should read as current. "/" highlights nothing. */
  activePath?: string;
}

const { activePath = Astro.url.pathname } = Astro.props;

function isActive(href: string): boolean {
  if (href === "/") return activePath === "/";
  return activePath === href || activePath.startsWith(`${href}/`);
}
---

<header class="site-header">
  <div class="shell header-inner">
    <a href="/" class="brand">
      <span>Jerome</span>
      <span>Yeoh</span>
    </a>

    <nav class="primary-nav" aria-label="Primary">
      <ul role="list">
        {NAV_ITEMS.map((item) => (
          <li>
            <a
              href={item.href}
              class:list={["nav-link", { "nav-link--active": isActive(item.href) }]}
              aria-current={isActive(item.href) ? "page" : undefined}
            >
              {item.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <a href="/resume.pdf" class="btn btn--filled btn--sm resume-btn" download>Résumé</a>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 60;
    background: color-mix(in srgb, var(--color-bg) 88%, transparent);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    border-bottom: var(--rule);
  }

  .header-inner {
    min-height: var(--header-height);
    display: flex;
    align-items: center;
    gap: 2rem;
  }

  .brand {
    font-family: var(--font-display);
    font-size: 0.9375rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    line-height: 1.15;
    text-transform: uppercase;
    color: var(--color-text);
    display: grid;
    margin-right: auto;
  }

  .brand:hover {
    color: var(--color-accent);
  }

  .primary-nav ul {
    display: flex;
    gap: 1.75rem;
  }

  .nav-link {
    font-family: var(--font-sans);
    font-size: 0.6875rem;
    font-weight: 500;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-text-muted);
    padding-bottom: 3px;
    border-bottom: 1px solid transparent;
    transition: color 0.15s ease, border-color 0.15s ease;
  }

  .nav-link:hover {
    color: var(--color-text);
  }

  .nav-link--active {
    color: var(--color-accent);
    border-bottom-color: var(--color-accent);
  }

  @media (max-width: 860px) {
    .primary-nav {
      display: none;
    }

    .header-inner {
      min-height: 64px;
    }
  }
</style>
