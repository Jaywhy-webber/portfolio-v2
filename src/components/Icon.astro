---
export type IconName = "github" | "linkedin" | "mail" | "check" | "chat" | "close";

interface Props {
  name: IconName;
  /** Any CSS length; the svg is square. */
  size?: string;
  class?: string;
}

const { name, size = "1.3rem", class: extra }: Props = Astro.props;
const dimensions = { width: size, height: size };
---

{name === "github" && (
  <svg
    viewBox="0 0 24 24"
    fill="currentColor"
    aria-hidden="true"
    focusable="false"
    class:list={["icon", extra]}
    style={dimensions}
  >
    <path d="M12 .5C5.37.5 0 5.87 0 12.5c0 5.3 3.44 9.8 8.21 11.39.6.11.82-.26.82-.58 0-.29-.01-1.05-.02-2.06-3.34.73-4.04-1.61-4.04-1.61-.55-1.39-1.34-1.76-1.34-1.76-1.09-.75.08-.73.08-.73 1.21.09 1.84 1.24 1.84 1.24 1.07 1.83 2.81 1.3 3.5.99.11-.78.42-1.3.76-1.6-2.67-.3-5.47-1.33-5.47-5.93 0-1.31.47-2.38 1.24-3.22-.13-.3-.54-1.52.11-3.18 0 0 1.01-.32 3.3 1.23a11.5 11.5 0 0 1 6 0c2.29-1.55 3.3-1.23 3.3-1.23.65 1.66.24 2.88.12 3.18.77.84 1.23 1.91 1.23 3.22 0 4.61-2.81 5.62-5.49 5.92.43.37.82 1.1.82 2.22 0 1.6-.02 2.9-.02 3.29 0 .32.22.7.83.58C20.56 22.29 24 17.8 24 12.5 24 5.87 18.63.5 12 .5Z" />
  </svg>
)}

{name === "linkedin" && (
  <svg
    viewBox="0 0 24 24"
    fill="currentColor"
    aria-hidden="true"
    focusable="false"
    class:list={["icon", extra]}
    style={dimensions}
  >
    <path d="M20.45 20.45h-3.56v-5.57c0-1.33-.03-3.04-1.85-3.04-1.86 0-2.14 1.45-2.14 2.94v5.67H9.35V9h3.41v1.56h.05c.47-.9 1.63-1.85 3.36-1.85 3.59 0 4.26 2.37 4.26 5.45v6.29ZM5.34 7.43a2.07 2.07 0 1 1 0-4.13 2.07 2.07 0 0 1 0 4.13Zm1.78 13.02H3.56V9h3.56v11.45ZM22.22 0H1.77C.79 0 0 .77 0 1.72v20.56C0 23.23.79 24 1.77 24h20.45c.98 0 1.78-.77 1.78-1.72V1.72C24 .77 23.2 0 22.22 0Z" />
  </svg>
)}

{name === "mail" && (
  <svg
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="1.7"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
    focusable="false"
    class:list={["icon", extra]}
    style={dimensions}
  >
    <rect x="2" y="4.5" width="20" height="15" rx="2" />
    <path d="m2.5 7 9.5 6 9.5-6" />
  </svg>
)}

{name === "chat" && (
  <svg
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="1.7"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
    focusable="false"
    class:list={["icon", extra]}
    style={dimensions}
  >
    <!--
      Rounded-rectangle bubble with a tail at the lower left. Every corner arc
      spans a 2.83 chord against r=2 (max 4), so none of them get silently
      rescaled — which is what warped the previous circular version, where one
      arc asked for a 17.24 chord at r=8.
    -->
    <path d="M20 4H4a2 2 0 0 0-2 2v9a2 2 0 0 0 2 2h3v4l5-4h8a2 2 0 0 0 2-2V6a2 2 0 0 0-2-2Z" />
    <path d="M7 9h10" />
    <path d="M7 12.5h6" />
  </svg>
)}

{name === "close" && (
  <svg
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="1.9"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
    focusable="false"
    class:list={["icon", extra]}
    style={dimensions}
  >
    <path d="M6 6 18 18" />
    <path d="M18 6 6 18" />
  </svg>
)}

{name === "check" && (
  <svg
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="2"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
    focusable="false"
    class:list={["icon", extra]}
    style={dimensions}
  >
    <path d="M20 6 9 17l-5-5" />
  </svg>
)}

<style>
  .icon {
    display: block;
    flex-shrink: 0;
  }
</style>
