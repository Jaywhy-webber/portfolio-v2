---
import PageLayout from "../layouts/PageLayout.astro";
import ProjectList from "../components/ProjectList.astro";
import CopyButton from "../components/CopyButton.astro";
import IconLink from "../components/IconLink.astro";
---

<PageLayout title="Jerome Yeoh — Portfolio">
  <div class="shell">
    <section class="hero">
      <h1 class="display hero-name">Jerome Yeoh</h1>
      <p class="hero-pitch">Business Analytics student at NUS &middot; Data &amp; AI</p>
      <p class="hero-degree">
        Bachelor of Science (Business Analytics), second major in Economics &middot;
        National University of Singapore
      </p>

      <div class="hero-actions">
        <a href="/resume.pdf" class="btn btn--filled" download>Download résumé</a>

        <CopyButton value="jeromeyeohhc@gmail.com" label="Copy email" icon="mail" />

        <IconLink
          href="https://github.com/Jaywhy-webber"
          icon="github"
          label="GitHub"
          tipValue="github.com/Jaywhy-webber"
          tipHint="(opens in a new tab)"
          external
        />

        <IconLink
          href="https://www.linkedin.com/in/jerome-yeoh-35a738217"
          icon="linkedin"
          label="LinkedIn"
          tipValue="linkedin.com/in/jerome-yeoh-35a738217"
          tipHint="(opens in a new tab)"
          external
        />
      </div>
    </section>

    <ProjectList />
  </div>
</PageLayout>

<style>
  .hero {
    padding-block: clamp(3.5rem, 9vw, 6.5rem) clamp(3rem, 7vw, 5rem);
    max-width: 44rem;
  }

  .hero-name {
    font-size: clamp(2.75rem, 7vw, 4.75rem);
  }

  .hero-pitch {
    margin-top: 1.1rem;
    font-size: clamp(1rem, 2vw, 1.2rem);
    color: var(--color-text-muted);
  }

  .hero-degree {
    margin-top: 0.45rem;
    font-size: 0.875rem;
    line-height: 1.6;
    color: var(--color-text-muted);
    opacity: 0.85;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    margin-top: 2.25rem;
  }
</style>
