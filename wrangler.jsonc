{
  // Must match v1's worker name: a workers.dev URL is
  // <worker-name>.<subdomain>.workers.dev, so this is what makes a deploy
  // take over portfolio.wawjerome.workers.dev rather than stand up a second
  // site beside it.
  "name": "portfolio",
  "main": "worker/index.ts",
  "compatibility_date": "2025-01-01",

  // The built site. The Worker serves these for every path except /api/chat.
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page"
  },

  // Endpoint and model only. The API key is a secret:
  //   wrangler secret put LLM_API_KEY
  // and locally it lives in .dev.vars, which is gitignored.
  //
  // The endpoint speaks the OpenAI chat-completions protocol but is NUS SoC's
  // LLM service, so the vars are named for the protocol, not the vendor.
  // "default" aliases an agentic-coding model and is the priciest chat option
  // in the catalogue: ~$0.0103 per question against this 22k-token corpus,
  // versus ~$0.0024 on gemma4:26b. The task is grounded restatement, not
  // coding, and 128k context is ample for a 22k corpus.
  "vars": {
    "LLM_BASE_URL": "https://soclaas-api.comp.nus.edu.sg/v1",
    "LLM_MODEL": "gemma4:26b"
  },

  // Per-IP rate limit. Cloudflare's binding only supports 10s or 60s windows.
  "ratelimits": [
    {
      "name": "CHAT_RATE_LIMIT",
      "namespace_id": "1001",
      "simple": { "limit": 10, "period": 60 }
    }
  ]
}
