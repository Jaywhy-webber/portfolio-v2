{
  // Must match v1's worker name: a workers.dev URL is
  // <worker-name>.<subdomain>.workers.dev, so this is what makes a deploy
  // take over portfolio.wawjerome.workers.dev rather than stand up a second
  // site beside it.
  "name": "portfolio",
  "main": "worker/index.ts",
  "compatibility_date": "2025-01-01",

  // The built site. The Worker serves these for every path except /api/chat.
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page"
  },

  // Endpoint and model only. The API key is a secret:
  //   wrangler secret put LLM_API_KEY
  // and locally it lives in .dev.vars, which is gitignored.
  //
  // The endpoint speaks the OpenAI chat-completions protocol but is NUS SoC's
  // LLM service, so the vars are named for the protocol, not the vendor.
  // "default" aliases an agentic-coding model and is the priciest chat option
  // in the catalogue: ~$0.0103 per question against this 22k-token corpus,
  // versus ~$0.0024 on gemma4:26b. The task is grounded restatement, not
  // coding, and 128k context is ample for a 22k corpus.
  //
  // qwen3.6:27b since 2026-11-12, chosen over gemma4:26b after gemma went down
  // on SoCLaaS (503 "no healthy provider backends"). It is an alias of
  // qwen3.8:27b. Picked from all 17 chat models on 14 eval cases, graded with
  // checkGlobal/checkCase and the same request body as the Worker: 12/14 with
  // a median 0.4s to first word, honouring reasoning_effort "none".
  //   - qwen3.6:35b: 10/14, 2.0s, a broken citation and "provided documents"
  //   - x-test-3: 13/14 and as fast, but a test model that can change
  //   - nemotron3.5:30b: obeyed prompt injection
  // About 1c a question against this corpus, four times gemma4's cost.
  // Because it is qwen3.8:27b, the eval's default judge, run evals with
  // JUDGE_MODEL set to another model so it does not grade itself.
  "vars": {
    "LLM_BASE_URL": "https://soclaas-api.comp.nus.edu.sg/v1",
    "LLM_MODEL": "qwen3.6:27b"
  },

  // Per-IP rate limit, 10 requests per 60s.
  //
  // Cloudflare's own rate-limiting binding was tried first and does not
  // enforce on this account: limit() returned success on 12 consecutive calls
  // past a 10/60s rule. This Durable Object counts requests itself.
  //
  // new_sqlite_classes rather than new_classes: SQLite-backed Durable Objects
  // are the ones available without a paid Workers plan.
  "durable_objects": {
    "bindings": [{ "name": "RATE_LIMITER", "class_name": "RateLimiter" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["RateLimiter"] }]
}
