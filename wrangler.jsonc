{
  "name": "portfolio-v2",
  "main": "worker/index.ts",
  "compatibility_date": "2025-01-01",

  // The built site. The Worker serves these for every path except /api/chat.
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page"
  },

  // Model id only. The API key is a secret:
  //   wrangler secret put OPENAI_API_KEY
  // and locally it lives in .dev.vars, which is gitignored.
  "vars": {
    "OPENAI_MODEL": "gpt-4o-mini"
  },

  // Per-IP rate limit. Cloudflare's binding only supports 10s or 60s windows,
  // so this is 10 messages per minute rather than the per-10-minutes figure
  // discussed; it still stops a script from running up a bill.
  "unsafe": {
    "bindings": [
      {
        "name": "CHAT_RATE_LIMIT",
        "type": "ratelimit",
        "namespace_id": "1001",
        "simple": { "limit": 10, "period": 60 }
      }
    ]
  }
}
